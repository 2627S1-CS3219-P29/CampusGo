{
   "tasks": {
        "dev": "deno run --allow-net --allow-read --allow-env --watch src/index.ts",
        "prisma": "deno run -A npm:prisma@^5.22.0",
        "db:migrate": "deno run -A npm:prisma@^5.22.0 migrate dev --schema=./prisma/schema.prisma --name init_suppliers",
        "db:generate": "deno run -A npm:prisma@^5.22.0 generate --schema=./prisma/schema.prisma"
    },
    "nodeModulesDir": "auto",
    "imports": {
        "@oak/oak": "jsr:@oak/oak@^17.1.3",
        "@std/csv": "jsr:@std/csv@^1.0.4",
        "@std/dotenv": "jsr:@std/dotenv@^0.225.3"
        "@prisma/client": "npm:@prisma/client@^5.22.0"
    }
}
