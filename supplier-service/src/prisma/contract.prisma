// use prisma-8

enum SupplierType {
    @@type("pg/text@1")
    Store = "store"
    Facility = "facility"
    Landmark = "landmark"
}

enum SupplierAuditAction {
    @@type("pg/text@1")
    Create = "create"
    Update = "update"
    Delete = "delete"
}

model Supplier {
    id Int @id @default(autoincrement())
    name String @unique
    type SupplierType
    description String?

    // stores/facilities sit at a landmark; landmarks are locations themselves
    locationId Int?
    location Supplier? @relation("SupplierLocation", fields: [locationId], references: [id])
    suppliersAtLocation Supplier[] @relation("SupplierLocation")

    // local campus time "HH:MM[:SS]"; both null when there are no opening hours.
    // closesAt < opensAt means the supplier is open past midnight
    opensAt TimeString?
    closesAt TimeString?

    // user ids from the user service, not a foreign key since it lives in another database
    createdBy Int
    updatedBy Int
    createdAt TimestamptzString @default(now())
    updatedAt TimestamptzString @default(now())
    // soft delete so that ids referenced by past errands stay resolvable (FR 5.9)
    deletedAt TimestamptzString?

    auditLogs SupplierAuditLog[]

    @@check(expression: "(type = 'landmark') = (\"locationId\" IS NULL)", name: "supplier_location_by_type")
    @@check(expression: "(\"opensAt\" IS NULL) = (\"closesAt\" IS NULL)", name: "supplier_hours_paired")
    @@check(expression: "type <> 'landmark' OR \"opensAt\" IS NULL", name: "supplier_landmark_no_hours")
    @@check(expression: "length(btrim(name)) > 0", name: "supplier_name_not_blank")

    // names are unique case-insensitively among live suppliers (FR 5.5.1), also backs sort by name
    @@index(expression: "lower(name)", unique: true, where: "(\"deletedAt\" IS NULL)", name: "supplier_name_active")
    @@index([type])
    @@index([locationId])
}

// append-only history of supplier changes (FR 5.12)
model SupplierAuditLog {
    id Int @id @default(autoincrement())
    supplierId Int
    action SupplierAuditAction
    actorUserId Int
    // full supplier row after the change (before it, for deletes)
    snapshot Json
    createdAt TimestamptzString @default(now())

    supplier Supplier @relation(fields: [supplierId], references: [id])

    @@index([supplierId])
}
