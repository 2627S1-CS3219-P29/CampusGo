    {
      "title": "Work queue progress",
      "type": "table",
      "description": "Ready backlog with no consumers can indicate a consumer outage. Increasing unacknowledged messages suggests slow/stuck processing. DLQs are excluded: they normally have no consumers. Only existing user/credit/order durable queues are scraped.",
      "datasource": {
        "type": "prometheus",
        "uid": "campusgo-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (queue) (rabbitmq_detailed_queue_messages_ready{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1))) or on(queue) ((0 * ((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) / 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "((sum by (queue) (rabbitmq_detailed_queue_messages_unacked{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1))) or on(queue) ((0 * ((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) / 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1))) or on(queue) ((0 * ((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) / 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "D",
          "expr": "((sum by (queue) (rabbitmq_detailed_queue_consumers{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1))) or on(queue) ((0 * ((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) / 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "E",
          "expr": "(((sum by (queue) (rate(rabbitmq_detailed_queue_messages_delivered_ack_total{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"}[$__rate_interval]))) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1))) + on(queue) ((sum by (queue) (rate(rabbitmq_detailed_queue_messages_delivered_total{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"}[$__rate_interval]))) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) or on(queue) ((0 * ((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) / 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "F",
          "expr": "((sum by (queue) (rate(rabbitmq_detailed_queue_messages_acked_total{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"}[$__rate_interval]))) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1))) or on(queue) ((0 * ((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) / 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "G",
          "expr": "((sum by (queue) (rate(rabbitmq_detailed_queue_messages_redelivered_total{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"}[$__rate_interval]))) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1))) or on(queue) ((0 * ((sum by (queue) (rabbitmq_detailed_queue_messages{job=\"rabbitmq-queues\",vhost=\"${vhost}\",queue!~\".*[.]dlq\"})) and on() ((min(up{job=\"rabbitmq\"}) == 1) and on() (min(up{job=\"rabbitmq-queues\"}) == 1)))) / 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "transformations": [
