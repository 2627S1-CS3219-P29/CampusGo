// use prisma-8

model UserCredits {
  userId      Int @id
  balance Int
}

model CreditsOnHold {
  errandId    Int @id
  requesterId Int
  supplierId  Int
  amount      Int
  status      CreditHoldStatus
}

enum CreditHoldStatus {
  @@type("pg/text@1")

  HELD     = "HELD"
  RELEASED = "RELEASED"
  REFUNDED = "REFUNDED"
}
