// use prisma-8

model User {
    id Int @id @default(autoincrement())
    email String @unique
    hashedPassword String

    // TODO: profile picture, requires s3 presigned storage
    // profilePictureFileHash String?
    nickname String
    contact String?
    
    createdAt TimestamptzString @default(now())
    
    roles Role[]
}

model UserRole {
    userId Int
    roleId Int

    assignedAt TimestamptzString @default(now())
    sourceInviteId Int? @unique
    
    user User @relation(fields: [userId], references: [id])
    role Role  @relation(fields: [roleId], references: [id])
    sourceInvite AdminInviteCode?  @relation(fields: [sourceInviteId], references: [id])
    @@id([userId, roleId])
}

model Role {
    id Int @id @default(autoincrement())
    name String @unique
    
    associatedUsers User[]
}

model AdminInviteCode {
    id Int @id @default(autoincrement())
    code String @unique
    createdAt TimestamptzString @default(now())
    createdById Int?
    
    createdBy User? @relation(fields: [createdById], references: [id])
    acceptedByUserRole UserRole?
}
