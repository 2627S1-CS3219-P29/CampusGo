// use prisma-8

// lifecycle of an errand, see the status rules in the order controller
enum OrderStatus {
    CREATED
    ACCEPTED
    PICKED_UP
    COMPLETED
    CANCELLED
    EXPIRED
}

model Order {
    // UUID generated by the service (crypto.randomUUID()) when the order is created
    id String @id
    // prevents duplicate orders if the client retries a dropped connection
    idempotencyKey String? @unique

    // user ids from the user service, not foreign keys since they live in another database
    requesterId Int
    // null until a courier accepts
    courierId Int?
    // every pickup is a registered supplier from the supplier service
    supplierId Int

    // snapshot of the supplier when the order was made, e.g. "Printer @ Com 2, Com 2, Level 1",
    // so past orders still read correctly if the supplier is renamed or deleted
    pickupLocation String
    // any place the requester types, e.g. "Foyer@PGP"
    dropoffLocation String
    itemDescription String // e.g. "Black gaming laptop"
    creditBounty Int // credits reserved for the errand
    additionalDetails String? // optional instructions

    status OrderStatus @default(CREATED)
    // unaccepted orders expire after this time
    expiresAt TimestamptzString
    createdAt TimestamptzString @default(now())
    updatedAt TimestamptzString @default(now())

    @@index([status])
    @@index([requesterId])
    @@index([courierId])
    // "order" is a reserved word in SQL, so the table is called "orders"
    @@map("orders")
}
