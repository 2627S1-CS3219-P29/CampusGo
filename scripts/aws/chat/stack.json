{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CampusGo single-instance chat service with private discovery, persistent RDS data and runtime secret injection",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Parameters": {
    "Cluster": {
      "Type": "String",
      "Default": "campusgo"
    },
    "NamespaceId": {
      "Type": "String"
    },
    "Subnets": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "SecurityGroups": {
      "Type": "List<AWS::EC2::SecurityGroup::Id>"
    },
    "Image": {
      "Type": "String"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    }
  },
  "Resources": {
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": {
          "Fn::Sub": "${Cluster}/chat-service"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "RuntimeSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Populate from the deployed backend configuration without exposing credentials in template or logs.",
          "must": [
            "Populate before schema initialization or starting the service.",
            "DATABASE_URL must point only to the chat database."
          ]
        }
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${Cluster}/chat/runtime"
        },
        "Description": "Chat database URL, shared JWT access secret and RabbitMQ connection",
        "Tags": [
          {
            "Key": "Application",
            "Value": {
              "Ref": "Cluster"
            }
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${Cluster}-chat"
        },
        "RetentionInDays": 7
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated ECS execution role reads only chat credentials, image and log stream.",
          "must": [
            "Do not grant other services access to this secret."
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ChatRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Repository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "RuntimeSecret"
                  },
                  "Condition": {
                    "Bool": {
                      "aws:SecureTransport": "true"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Discovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "chat",
        "DnsConfig": {
          "NamespaceId": {
            "Ref": "NamespaceId"
          },
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Chat runtime and one-off schema initialization share the same immutable image and injected secret.",
          "must": [
            "Initialize and verify the chat schema before DesiredCount=1."
          ]
        }
      },
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "chat",
            "Image": {
              "Ref": "Image"
            },
            "Essential": true,
            "Command": [
              "deno",
              "run",
              "-A",
              "src/index.ts"
            ],
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "PORT",
                "Value": "3000"
              },
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "CHAT_RETENTION_MINUTES",
                "Value": "180"
              }
            ],
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecret}:DATABASE_URL::"
                }
              },
              {
                "Name": "JWT_ACCESS_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecret}:JWT_ACCESS_SECRET::"
                }
              },
              {
                "Name": "RABBITMQ_CONNECTION",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecret}:RABBITMQ_CONNECTION::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "ecs"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD",
                "deno",
                "eval",
                "const r=await fetch('http://127.0.0.1:3000/public/health');Deno.exit(r.ok?0:1)"
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 60
            },
            "StopTimeout": 30
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Single replica is required for in-memory WebSocket fanout. Stop old task before starting its replacement.",
          "must": [
            "DesiredCount must be 0 or 1 until shared fanout is implemented.",
            "No public inbound access; reuse existing internal and database client security groups."
          ]
        }
      },
      "Properties": {
        "ServiceName": "chat-service",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 0,
          "MaximumPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Ref": "Subnets"
            },
            "SecurityGroups": {
              "Ref": "SecurityGroups"
            }
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "Discovery",
                "Arn"
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "TaskDefinition": {
      "Value": {
        "Ref": "Task"
      }
    },
    "RuntimeSecretArn": {
      "Value": {
        "Ref": "RuntimeSecret"
      }
    },
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      }
    }
  }
}
