{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CampusGo demo monitoring with SSM-only dashboard ingress and ephemeral history",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "Subnets": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "ApplicationSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "BrokerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "BrokerPrivateIp": {
      "Type": "String"
    },
    "NamespaceId": {
      "Type": "String"
    },
    "ExecutionRoleArn": {
      "Type": "String",
      "Description": "Legacy application execution role parameter; monitoring now uses its own scoped role."
    },
    "GrafanaImage": {
      "Type": "String"
    },
    "TempoImage": {
      "Type": "String"
    },
    "CollectorImage": {
      "Type": "String"
    },
    "PrometheusImage": {
      "Type": "String"
    },
    "Cluster": {
      "Type": "String",
      "Default": "campusgo"
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Monitoring access from application tasks and SSM broker host",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 4318,
            "ToPort": 4318,
            "SourceSecurityGroupId": {
              "Ref": "ApplicationSecurityGroup"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 3000,
            "ToPort": 3000,
            "SourceSecurityGroupId": {
              "Ref": "BrokerSecurityGroup"
            }
          }
        ]
      }
    },
    "BrokerMetricsIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "BrokerSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 15692,
        "ToPort": 15692,
        "SourceSecurityGroupId": {
          "Ref": "SecurityGroup"
        }
      }
    },
    "Discovery": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "monitoring",
        "DnsConfig": {
          "NamespaceId": {
            "Ref": "NamespaceId"
          },
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 10
            }
          ],
          "RoutingPolicy": "MULTIVALUE"
        },
        "HealthCheckCustomConfig": {
          "FailureThreshold": 1
        }
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "1024",
        "Memory": "2048",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "MonitoringExecutionRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "grafana",
            "Image": {
              "Ref": "GrafanaImage"
            },
            "Essential": true,
            "Memory": 512,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "grafana"
              }
            },
            "Environment": [
              {
                "Name": "GF_AUTH_ANONYMOUS_ENABLED",
                "Value": "true"
              },
              {
                "Name": "GF_AUTH_ANONYMOUS_ORG_ROLE",
                "Value": "Viewer"
              },
              {
                "Name": "GF_AUTH_DISABLE_LOGIN_FORM",
                "Value": "false"
              },
              {
                "Name": "GF_SECURITY_DISABLE_INITIAL_ADMIN_CREATION",
                "Value": "false"
              },
              {
                "Name": "GF_USERS_ALLOW_SIGN_UP",
                "Value": "false"
              },
              {
                "Name": "GF_ANALYTICS_REPORTING_ENABLED",
                "Value": "false"
              },
              {
                "Name": "GF_SECURITY_ADMIN_USER",
                "Value": "admin"
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 3000
              }
            ],
            "Secrets": [
              {
                "Name": "GF_SECURITY_ADMIN_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${GrafanaAdminSecret}:password::"
                }
              }
            ]
          },
          {
            "Name": "tempo",
            "Image": {
              "Ref": "TempoImage"
            },
            "Essential": true,
            "Memory": 768,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "tempo"
              }
            },
            "Command": [
              "-target=all",
              "-config.file=/etc/tempo/config.yaml"
            ]
          },
          {
            "Name": "collector",
            "Image": {
              "Ref": "CollectorImage"
            },
            "Essential": true,
            "Memory": 256,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "collector"
              }
            },
            "Command": [
              "--config=/etc/otelcol/config.yaml"
            ],
            "PortMappings": [
              {
                "ContainerPort": 4318
              }
            ]
          },
          {
            "Name": "prometheus",
            "Image": {
              "Ref": "PrometheusImage"
            },
            "Essential": true,
            "Memory": 512,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "prometheus"
              }
            },
            "Environment": [
              {
                "Name": "BROKER_METRICS_HOST",
                "Value": {
                  "Ref": "BrokerPrivateIp"
                }
              }
            ]
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Anonymous viewing plus authenticated administration; dashboards baked into the immutable image.",
          "must": [
            "Keep anonymous role Viewer.",
            "Task replacement loses metrics, traces and UI changes; source dashboards remain authoritative."
          ]
        }
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "monitoring-service",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 0,
          "MaximumPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": {
              "Ref": "Subnets"
            },
            "SecurityGroups": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        },
        "ServiceRegistries": [
          {
            "RegistryArn": {
              "Fn::GetAtt": [
                "Discovery",
                "Arn"
              ]
            }
          }
        ]
      }
    },
    "GrafanaSecretKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Encrypt the retained Grafana bootstrap credential independently of task storage.",
          "must": [
            "Retain key while the admin secret exists."
          ]
        }
      },
      "Properties": {
        "Description": "Grafana administrator secret encryption",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "GrafanaAdminSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Generated bootstrap login survives replacement of ephemeral Grafana tasks.",
          "must": [
            "Never store the password in template parameters, outputs or plaintext task environment.",
            "Rotate the secret and replace Grafana together; changing only the secret does not update a running Grafana database."
          ]
        }
      },
      "Properties": {
        "Description": "CampusGo Grafana administrator login",
        "KmsKeyId": {
          "Ref": "GrafanaSecretKey"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"admin\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "MonitoringExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Dedicated monitoring execution role prevents application tasks from gaining access to the Grafana admin password.",
          "must": [
            "Limit secret access to GrafanaAdminSecret."
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "MonitoringRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/campusgo/monitoring-grafana"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/campusgo/monitoring-tempo"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/campusgo/monitoring-collector"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/campusgo/monitoring-prometheus"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue",
                    "secretsmanager:DescribeSecret"
                  ],
                  "Resource": {
                    "Ref": "GrafanaAdminSecret"
                  },
                  "Condition": {
                    "Bool": {
                      "aws:SecureTransport": "true"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:DescribeKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "GrafanaSecretKey",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "secretsmanager.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "CollectorEndpoint": {
      "Value": "http://monitoring.campusgo.local:4318"
    },
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "Logs"
      }
    },
    "GrafanaAdminSecretArn": {
      "Description": "Secret containing Grafana admin username and password",
      "Value": {
        "Ref": "GrafanaAdminSecret"
      }
    }
  },
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  }
}
